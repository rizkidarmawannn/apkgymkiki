{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.8.0"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(css|js|images|fonts|build)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(favicon\\.ico|robots\\.txt)",
            "dest": "/public/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "GymTracker",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://apkgymkiki.vercel.app",
        "APP_KEY": "base64:rIHT0O6HSDVFVI2JHWRjQ0pwL1bAmYwNYTM4u2ecETU=",
        "APP_CONFIG_CACHE": "/tmp/bootstrap/cache/config.php",
        "APP_EVENTS_CACHE": "/tmp/bootstrap/cache/events.php",
        "APP_PACKAGES_CACHE": "/tmp/bootstrap/cache/packages.php",
        "APP_ROUTES_CACHE": "/tmp/bootstrap/cache/routes.php",
        "APP_SERVICES_CACHE": "/tmp/bootstrap/cache/services.php",
        "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
        "CACHE_STORE": "array",
        "SESSION_DRIVER": "cookie",
        "LOG_CHANNEL": "stderr",
        "DB_CONNECTION": "pgsql",
        "DB_URL": "postgresql://neondb_owner:npg_BriJg0Dhe3pw@ep-wispy-violet-b33wpdf6.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
    }
}